# ============================================================
# DocuMind Environment Configuration
# Copy this file to .env and configure your API keys.
# ============================================================

# --- LLM Providers ---
# Choose "openrouter" or "openai" (auto-detected if key is provided)
LLM_PROVIDER=openrouter

# OpenRouter (default free/low-cost models supported)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embedding Configuration ---
# HuggingFace sentence-transformers model (runs locally via PyTorch)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Document Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval & Grounding Thresholds ---
TOP_K=5
MAX_CONTEXT_CHUNKS=5
SIMILARITY_THRESHOLD=0.50
MIN_SIMILARITY_GAP=0.0

# --- Hallucination Control Fallback ---
FALLBACK_ANSWER=I couldn't find the answer in the provided documentation.

# --- Limits & Timeouts ---
MAX_FILE_SIZE_MB=25
REQUEST_TIMEOUT_SECONDS=60